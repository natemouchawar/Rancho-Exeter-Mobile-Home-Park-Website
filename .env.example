# Copy to .env and fill in your MailerLite credentials.
# For Vercel, set these same keys in Project Settings → Environment Variables.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Website inquiry delivery: Resend free plan, verified sending domain.
# Keep these server-side; never add them to browser JavaScript.
RESEND_API_KEY=
INQUIRY_FROM=Rancho Exeter Website <website@notify.ranchoexetermhp.com>
# Optional exact additional preview origins, separated by commas.
INQUIRY_ALLOWED_ORIGINS=
